{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kondate",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kondate",
      "database_id": "0c78c9ea-52dc-46ec-994d-17ee7a607bc8",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "4001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "4002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "674715201485-v8pugkcd7a0sc6tflormd7p9mss7j8u7.apps.googleusercontent.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  }
}
